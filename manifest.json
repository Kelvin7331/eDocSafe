{
  "name": "e-DocSafe — Secure Document Management",
  "short_name": "e-DocSafe",
  "description": "A secure, offline-first Progressive Web App for managing and storing your important documents with end-to-end encryption and cloud sync.",
  "start_url": "/index.html",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1f2937",
  "theme_color": "#27ae60",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "utilities", "business"],

